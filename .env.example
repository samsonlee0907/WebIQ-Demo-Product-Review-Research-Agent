# Offline walkthroughs work with these defaults. No cloud resources are provisioned.
# Use uvicorn --env-file .env to load this file; importing the app does not load it.
# Existing process environment variables take precedence over --env-file values.

# Microsoft Foundry: fill in your own resource values before using live research.
# The model value is a deployment name, not a model catalog ID.
FOUNDRY_TENANT_ID=
FOUNDRY_SUBSCRIPTION_ID=
FOUNDRY_RESOURCE_GROUP=
FOUNDRY_ACCOUNT_NAME=
FOUNDRY_PROJECT_NAME=
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=
FOUNDRY_TOOLBOX_NAME=

# Local authentication: sign in manually once to the tenant, then pin your account.
# The application only reads the cached sign-in; it never opens a sign-in prompt.
FOUNDRY_AUTHORIZED_OBJECT_ID=
FOUNDRY_ACCOUNT_UPN=

# Azure BAT only: configure a Playwright workspace and Foundry tool connection.
PLAYWRIGHT_CONNECTION_NAME=
PLAYWRIGHT_WORKSPACE_NAME=
PLAYWRIGHT_WORKSPACE_RESOURCE_ID=

# Hosted authentication: user-assigned identity client ID (not principal/object ID).
FOUNDRY_MANAGED_IDENTITY_CLIENT_ID=

# WebIQ keys are entered in the portal, never this file or command-line arguments.
# Without a key, live discovery requires the toolbox's web_search tool.

# Local development. Keep bound to loopback without the passcode gate.
PDD_HOSTED_MODE=false
PDD_REQUIRE_PASSCODE=false
PDD_PASSCODE_SHA256=
PDD_SESSION_SIGNING_SECRET=
PDD_TRUSTED_INGRESS_PROXY=none
PDD_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
PDD_ALLOWED_ORIGINS=
PDD_MAX_CONCURRENT_RUNS=2
PDD_MAX_CONCURRENT_LIVE_RUNS=1
PDD_RUN_TIMEOUT_SECONDS=1200

# Durable evidence. Local default: ignored api\private_history\.
# Hosted mode requires the account URL, an authorized identity and network access.
PDD_EVIDENCE_DIRECTORY=
PDD_EVIDENCE_BLOB_ACCOUNT_URL=
PDD_EVIDENCE_BLOB_CONTAINER=research-evidence

# Optional Azure bootstrap helpers. Configure before explicitly applying a plan.
# Resources are created in your subscription; these are not shared demo settings.
PDD_RESOURCE_GROUP=
PDD_AZURE_LOCATION=
PDD_ACR_NAME=
PDD_IDENTITY_NAME=pdd-portal-identity
PDD_CONTAINER_APP_NAME=pdd-portal
PDD_CONTAINER_ENVIRONMENT_NAME=pdd-environment
# Access files must stay outside the repository. Leave blank for a user-local default.
PDD_PASSCODE_FILE=

# Optional Windows VM worker. Set the actual HTTPS portal URL after deployment.
PDD_PORTAL_URL=
PDD_VM_NAME=pdd-browser-worker
PDD_VM_SIZE=Standard_D2s_v5
PDD_VM_LOCATION=
CHROME_EXECUTABLE_PATH=
