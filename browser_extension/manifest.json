{
  "manifest_version": 3,
  "name": "Product Due-Diligence Agent — Chrome Browser Bridge",
  "version": "1.1.1",
  "description": "Connects the research portal to a desktop browser for read-only observations and genuine screenshots.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "portal_content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
